# Built-in KSUN + kernel-patched SUSFS and the fixed NoMount bundle.
# LTO, BBG, CONFIG_LSM and optional networking are generated from this run's inputs.
CONFIG_ARM64=y
CONFIG_KPROBES=y
CONFIG_THREAD_INFO_IN_TASK=y
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
# Samsung-only initialization aborts on generic GKI kernels; keep these disabled.
# CONFIG_KSU_SAMSUNG_KDP is not set
# CONFIG_KSU_SAMSUNG_RKP is not set
# CONFIG_KSU_SAMSUNG_DEFEX is not set
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set
CONFIG_NOMOUNT=y
CONFIG_KEYS=y
CONFIG_CFI_CLANG=y
CONFIG_SECURITY_SELINUX=y
# CONFIG_NTSYNC is not set
